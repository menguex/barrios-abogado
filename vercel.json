{
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "barrios-abogado.vercel.app" }],
      "destination": "https://barriosabogado.cl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.barriosabogado.cl" }],
      "destination": "https://barriosabogado.cl/:path*",
      "permanent": true
    }
  ]
}
